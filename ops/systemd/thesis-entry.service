[Unit]
Description=c11 thesis-entry nightly plan (oneshot, fired by thesis-entry.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python -m c11_thesis.service
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
