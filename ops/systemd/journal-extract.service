[Unit]
Description=Nightly compact journal extract to GitHub branch journal-extract (oneshot, fired by journal-extract.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python /opt/pipeline/ops/journal_extract.py
TimeoutStartSec=1200
StandardOutput=journal
StandardError=journal
