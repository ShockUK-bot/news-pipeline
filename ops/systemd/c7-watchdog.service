[Unit]
Description=C7 watchdog pass (oneshot, fired by c7-watchdog.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python -m c7_watchdog.service
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
