[Unit]
Description=a11-metrics nightly measurement layer (oneshot, fired by a11-metrics.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python -m a11_metrics.service --report
TimeoutStartSec=1500
StandardOutput=journal
StandardError=journal
