[Unit]
Description=macro-fetch FRED series refresh (oneshot, fired by macro-fetch.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python -m c1_ingestion.macro
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
