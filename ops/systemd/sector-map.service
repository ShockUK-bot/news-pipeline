[Unit]
Description=sector-map nightly ticker to sector refresh from SEC SIC codes (oneshot, fired by sector-map.timer)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline/src
EnvironmentFile=/etc/pipeline/pipeline.env
ExecStart=/opt/pipeline/.venv/bin/python -m common.sectors --refresh --days 7
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
